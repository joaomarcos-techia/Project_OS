# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Build
dist/
build/

# Environment
.env
.env.local
.env.*.local
# .env.example is a committed template (placeholders only, no secrets) — do NOT ignore it.
!.env.example

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tests
coverage/
.vitest/

# Deploy / hosting
.vercel/
.turbo/

# Database operations (C1+)
backups/
# Incident sentinel — written by scripts/db-migrate-prod.ts on failure.
# Operator-local: must be resolved + deleted before any re-run. Not for git.
MIGRATION_FAILED.md

# OS
.DS_Store
Thumbs.db

# Cache
*.tsbuildinfo

# Sentry Config File
.env.sentry-build-plugin

# Security scan artifacts (auditoria de segurança — Semgrep/CodeQL SARIF, local-only)
static_analysis_*/
*.sarif
codeql-db/
# Vercel CLI (`vercel link`) — .vercel guarda project/org id + o VERCEL_OIDC_TOKEN.
.vercel

# NÃO adicionar `.env*` aqui: o `vercel link` acrescenta essa linha sozinho e ela é a
# ÚLTIMA a casar, então anula o `!.env.example` de cima (last-match-wins) e passa a
# ignorar o template versionado. Hoje o .env.example só escapa por já estar rastreado —
# num clone novo, sumiria em silêncio. As regras .env / .env.local / .env.*.local
# acima já cobrem os arquivos reais de segredo.
