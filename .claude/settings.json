{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Write(.claude/memory.md)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\joaom\\OneDrive\\Área de Trabalho\\ClinicaOS_V2\\.claude\\hooks\\inject-memory.ps1\"",
            "timeout": 10,
            "statusMessage": "Carregando memory.md..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\joaom\\OneDrive\\Área de Trabalho\\ClinicaOS_V2\\.claude\\hooks\\log-edit.ps1\"",
            "timeout": 15,
            "statusMessage": "Registrando edição no memory.md..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
