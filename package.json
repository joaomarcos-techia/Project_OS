{
  "name": "clinicaos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "madge --circular --extensions ts,tsx src",
    "arch:db-check": "tsx scripts/arch-db-check.ts",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:dev": "tsx scripts/db-migrate-dev.ts",
    "db:migrate:prod": "tsx scripts/db-migrate-prod.ts",
    "db:backup:prod": "tsx scripts/db-backup-prod.ts",
    "db:studio": "tsx scripts/db-studio.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.36.4",
    "next": "15.5.18",
    "postgres": "3.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
