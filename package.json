{
  "name": "clinicaos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "madge --circular --extensions ts,tsx src",
    "arch:db-check": "tsx scripts/arch-db-check.ts",
    "check:migrations": "tsx scripts/check-migration-safety.ts",
    "bump-role-claims": "tsx scripts/bump-role-claims.ts",
    "audit:partitions": "tsx scripts/audit-partition-maintenance.ts",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:dev": "tsx scripts/db-migrate-dev.ts",
    "db:migrate:prod": "tsx scripts/db-migrate-prod.ts",
    "db:backup:prod": "tsx scripts/db-backup-prod.ts",
    "db:studio": "tsx scripts/db-studio.ts",
    "seed:super-admin": "tsx scripts/seed-super-admin.ts",
    "seed:clinic-user": "tsx scripts/seed-clinic-user.ts",
    "seed:c9": "tsx --conditions=react-server scripts/seed-c9-test.ts",
    "seed:lgpd-bucket": "tsx --conditions=react-server scripts/seed-lgpd-bucket.ts",
    "worker:once": "tsx --conditions=react-server scripts/run-outbox-once.ts",
    "hard-delete:once": "tsx --conditions=react-server scripts/run-hard-delete.ts",
    "smoke:c5:idem": "tsx scripts/smoke-c5-idempotency.ts",
    "smoke:c3": "tsx scripts/smoke-c3.ts",
    "smoke:c3:manual": "tsx scripts/smoke-c3-manual.ts",
    "test:hook": "tsx scripts/test-hook.ts",
    "test:auth-e2e": "tsx scripts/smoke-login.ts",
    "smoke:c4": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c4.ts",
    "smoke:c5": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c5.ts",
    "smoke:c6": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c6.ts",
    "smoke:c7": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c7.ts",
    "smoke:c8": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c8.ts",
    "smoke:c9": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c9.ts",
    "smoke:c10": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 META_APP_SECRET=smoke-app-secret META_WEBHOOK_VERIFY_TOKEN=verify-me CRYPTO_LOOKUP_SALT=c21va2UtYzEwLWxvb2t1cC1zYWx0LTMyLWJ5dGVzLW9rIQ== tsx --conditions=react-server scripts/smoke-c10.ts",
    "wa:connect": "tsx --conditions=react-server scripts/whatsapp-connect.ts",
    "check:registry": "cross-env OUTBOX_CRON_ALLOW_NON_VERCEL=true tsx --conditions=react-server scripts/check-handler-registry.ts",
    "check:registry:strict": "cross-env OUTBOX_CRON_ALLOW_NON_VERCEL=true tsx --conditions=react-server scripts/check-handler-registry.ts --strict",
    "idempotency:cleanup": "tsx scripts/idempotency-cleanup.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.4",
    "geist": "1.7.2",
    "lucide-react": "1.17.0",
    "next": "15.5.18",
    "p-limit": "5.0.0",
    "postgres": "3.4.5",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "safe-stable-stringify": "2.5.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "happy-dom": "^20.10.1",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "8.5.15"
    }
  }
}
