{
  "name": "clinicaos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "cross-env NODE_OPTIONS=--conditions=react-server playwright test",
    "test:e2e:ui": "playwright test --ui",
    "arch:check": "madge --circular --extensions ts,tsx src",
    "arch:db-check": "tsx scripts/arch-db-check.ts",
    "arch:graphs": "tsx scripts/arch-graphs.ts",
    "check:migrations": "tsx scripts/check-migration-safety.ts",
    "check:observability": "tsx scripts/check-observability-drift.ts",
    "bump-role-claims": "tsx scripts/bump-role-claims.ts",
    "audit:partitions": "tsx scripts/audit-partition-maintenance.ts",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate --config=drizzle.config.ts",
    "db:encrypt-clinical": "tsx --conditions=react-server scripts/encrypt-clinical-content.ts",
    "db:encrypt-business-pii": "tsx --conditions=react-server scripts/encrypt-business-pii.ts",
    "gen:receituario": "tsx --tsconfig tsconfig.scripts.json scripts/gen-receituario-example.ts",
    "db:migrate:dev": "tsx scripts/db-migrate-dev.ts",
    "db:migrate:prod": "tsx scripts/db-migrate-prod.ts",
    "db:backup:prod": "tsx scripts/db-backup-prod.ts",
    "cleanup:test-clinics:prod": "tsx scripts/delete-test-clinics-prod.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "db:studio": "tsx scripts/db-studio.ts",
    "seed:super-admin": "tsx scripts/seed-super-admin.ts",
    "seed:clinic-user": "tsx scripts/seed-clinic-user.ts",
    "reset:dev": "tsx scripts/reset-dev-data.ts",
    "reset:prod": "tsx scripts/reset-prod-data.ts",
    "seed:dev": "tsx --conditions=react-server scripts/seed-dev-clinic.ts",
    "seed:c9": "tsx --conditions=react-server scripts/seed-c9-test.ts",
    "seed:plans": "tsx --conditions=react-server scripts/seed-plans.ts",
    "seed:admin-bucket": "tsx --conditions=react-server scripts/seed-admin-bucket.ts",
    "seed:logo-bucket": "tsx --conditions=react-server scripts/seed-logo-bucket.ts",
    "seed:c15": "tsx --conditions=react-server scripts/seed-c15-test.ts",
    "billing:live-check": "tsx --conditions=react-server scripts/asaas-live-check.ts",
    "billing:card-live-check": "tsx --conditions=react-server scripts/asaas-card-live-check.ts",
    "billing:live-roundtrip": "tsx --conditions=react-server scripts/asaas-live-roundtrip.ts",
    "email:live-check": "tsx --conditions=react-server scripts/resend-live-check.ts",
    "smoke:c13": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c13.ts",
    "smoke:c14": "cross-env OUTBOX_BATCH_SIZE=10 OUTBOX_PARALLELISM=1 tsx --conditions=react-server scripts/smoke-c14.ts",
    "wa:send-template": "tsx --conditions=react-server scripts/wa-send-template.ts",
    "seed:lgpd-bucket": "tsx --conditions=react-server scripts/seed-lgpd-bucket.ts",
    "worker:once": "tsx --conditions=react-server scripts/run-outbox-once.ts",
    "hard-delete:once": "tsx --conditions=react-server scripts/run-hard-delete.ts",
    "smoke:c5:idem": "tsx scripts/smoke-c5-idempotency.ts",
    "smoke:c3": "tsx scripts/smoke-c3.ts",
    "smoke:c3:manual": "tsx scripts/smoke-c3-manual.ts",
    "test:hook": "tsx scripts/test-hook.ts",
    "test:auth-e2e": "tsx scripts/smoke-login.ts",
    "smoke:c4": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c4.ts",
    "smoke:c5": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c5.ts",
    "smoke:c6": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c6.ts",
    "smoke:c7": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c7.ts",
    "smoke:c8": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c8.ts",
    "smoke:c9": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 tsx --conditions=react-server scripts/smoke-c9.ts",
    "smoke:c10": "cross-env OUTBOX_BATCH_SIZE=5 OUTBOX_PARALLELISM=2 META_APP_SECRET=smoke-app-secret META_WEBHOOK_VERIFY_TOKEN=verify-me CRYPTO_LOOKUP_SALT=c21va2UtYzEwLWxvb2t1cC1zYWx0LTMyLWJ5dGVzLW9rIQ== tsx --conditions=react-server scripts/smoke-c10.ts",
    "smoke:c11": "cross-env OUTBOX_BATCH_SIZE=10 OUTBOX_PARALLELISM=1 GEMINI_API_KEY=smoke-gemini-key AI_SNAPSHOT_MODE=full tsx --conditions=react-server scripts/smoke-c11.ts",
    "smoke:c12": "cross-env OUTBOX_BATCH_SIZE=10 OUTBOX_PARALLELISM=1 GEMINI_API_KEY=smoke-gemini-key AI_SNAPSHOT_MODE=off tsx --conditions=react-server scripts/smoke-c12.ts",
    "smoke:admin-config": "cross-env OUTBOX_BATCH_SIZE=10 OUTBOX_PARALLELISM=1 GEMINI_API_KEY=smoke-gemini-key AI_SNAPSHOT_MODE=off tsx --conditions=react-server scripts/smoke-admin-config.ts",
    "smoke:onboarding": "cross-env MAGIC_TOKEN_SECRET=smoke-magic-token-secret-32bytes-ok! tsx --conditions=react-server scripts/smoke-onboarding.ts",
    "ai:live-check": "tsx --conditions=react-server scripts/gemini-live-check.ts",
    "ai:adversarial": "tsx --conditions=react-server scripts/ai-adversarial-check.ts",
    "smoke:remediation": "tsx --conditions=react-server scripts/smoke-remediation.ts",
    "smoke:conversas": "tsx --conditions=react-server scripts/smoke-conversas.ts",
    "smoke:journeys": "cross-env OUTBOX_BATCH_SIZE=10 OUTBOX_PARALLELISM=1 GEMINI_API_KEY=smoke-gemini-key AI_SNAPSHOT_MODE=off tsx --conditions=react-server scripts/smoke-agent-journeys.ts",
    "wa:connect": "tsx --conditions=react-server scripts/whatsapp-connect.ts",
    "check:registry": "cross-env OUTBOX_CRON_ALLOW_NON_VERCEL=true tsx --conditions=react-server scripts/check-handler-registry.ts",
    "check:registry:strict": "cross-env OUTBOX_CRON_ALLOW_NON_VERCEL=true tsx --conditions=react-server scripts/check-handler-registry.ts --strict",
    "idempotency:cleanup": "tsx scripts/idempotency-cleanup.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.6",
    "@radix-ui/react-dialog": "1.1.18",
    "@radix-ui/react-dropdown-menu": "2.1.19",
    "@radix-ui/react-popover": "1.1.18",
    "@radix-ui/react-switch": "1.3.2",
    "@radix-ui/react-tabs": "1.1.16",
    "@radix-ui/react-tooltip": "1.2.11",
    "@react-pdf/renderer": "4.5.1",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.17.0",
    "next": "15.5.21",
    "p-limit": "5.0.0",
    "postgres": "3.4.5",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "safe-stable-stringify": "2.5.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "happy-dom": "^20.10.1",
    "madge": "^8.0.0",
    "pdfjs-dist": "^6.0.227",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
