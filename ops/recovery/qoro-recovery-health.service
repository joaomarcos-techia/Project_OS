[Unit]
Description=Check Qoro encrypted backup freshness and SHA256
OnFailure=qoro-recovery-alert@%n.service

[Service]
Type=oneshot
User=qoro-recovery
Group=qoro-recovery
WorkingDirectory=/opt/qoro-recovery
ExecStart=/usr/bin/node --import tsx scripts/recovery-scheduled-backup.ts --check
StateDirectory=qoro-recovery
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/qoro-recovery

