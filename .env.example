# ClinicaOS — Template de variáveis de ambiente
#
# Copie para `.env.local` (gitignored) e preencha. Fonte da verdade do contrato:
#   src/lib/env.ts  (validação Zod no boot — build/dev falham cedo se inválido).
# Docs: docs/development/environment.md
#
# NUNCA comite segredos reais. Este arquivo só tem placeholders.
# Legenda:  [dev]  precisa para rodar localmente
#           [runtime] exigido só quando a feature roda (guard assert*RuntimeReady)
#           [prod]  só em produção / scripts prod — deixe VAZIO em dev

# =====================================================================
# MÍNIMO PARA BOOTAR (`pnpm dev` + migrations)
# =====================================================================

# --- Database (C1) ---
# [dev] String de conexão do Postgres (Supabase dev "qoro-dev"). sslmode=require.
DATABASE_URL="postgresql://postgres:senha@host:6543/postgres?sslmode=require"
# [prod] Só lido por db:migrate:prod / db:backup:prod. Deixe VAZIO em dev.
DATABASE_URL_PROD=

# --- Supabase ---
# [dev] URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# [dev] Chave publishable (client-safe, protegida por RLS). Aceita a legada anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_ANON_KEY=            # (legado — use publishable acima)
# [dev/C3] Chave secret (server-only, bypassa RLS). Exigida a partir de C3.
SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_SERVICE_ROLE_KEY=               # (legado — use secret acima)

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="info"                            # debug | info | warn | error

# --- Operacional (scripts prod) ---
# [prod] Opt-in explícito exigido por db:migrate:prod / db:backup:prod. Vazio em dev.
SUPABASE_PROJECT_ENV=

# =====================================================================
# C3 — Identity / Auth / Rate limit
# =====================================================================
# [runtime] Pepper HMAC dos e-mails em login_attempts. MÍNIMO 32 chars.
LOGIN_HASH_PEPPER=""
# [runtime] Upstash Redis (rate limit dual IP + email_hash).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# [dev/setup] Bootstrap do super_admin via `pnpm seed:super-admin`.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""                      # mínimo 12 chars

# =====================================================================
# C4 — Outbox / Cron
# =====================================================================
# [runtime] Segredo compartilhado com o Vercel Cron (Bearer). MÍNIMO 32 chars.
# É o ÚNICO gate das rotas /api/cron/** (single-factor — ver F-09 em
# src/lib/http/cron-auth.ts) e também das rotas /api/health/**.
CRON_SECRET=""
# [opcional, V5] Segredo SEPARADO para os crons destrutivos (patient-hard-delete,
# data-retention, billing-dunning). Ausente → essas rotas caem no CRON_SECRET
# (retrocompat). Definido → o agendador DELAS deve enviar este. Reduz o blast radius:
# vazar o segredo de monitoring deixa de dar acesso a apagar PII.
# CRON_SECRET_DESTRUCTIVE=""
# [opcional] Silencia a métrica `cron.origin_header_missing` quando o cron é
# disparado fora da Vercel de propósito (smoke local, curl de runbook). NÃO é auth.
# OUTBOX_CRON_ALLOW_NON_VERCEL=true
# Tuning do worker (defaults sensatos — só mexa se souber por quê).
OUTBOX_BATCH_SIZE=50
OUTBOX_PARALLELISM=5
# OUTBOX_IDEMPOTENCY_LOCK_TIMEOUT_MS=10000
# OUTBOX_MAX_PAYLOAD_BYTES=65536

# =====================================================================
# C5 — Encryption per-tenant (AES-256-GCM + HKDF)
# =====================================================================
# [runtime] Backend de segredos: 'env' em dev, 'gcp' em prod (default por NODE_ENV).
CRYPTO_SECRET_BACKEND="env"
# [runtime] Master key AES 32 bytes, base64. NUNCA comite uma chave real.
CRYPTO_MASTER_KEY_V1=""
# CRYPTO_MASTER_KEY_V2=                      # só durante rotação de chave
MASTER_KEY_VERSION=1
# [runtime] Salt global do lookup HMAC (cpf_hash/telefone_hash), base64.
CRYPTO_LOOKUP_SALT=""
# [prod] GCP Secret Manager (usado quando CRYPTO_SECRET_BACKEND=gcp).
GCP_PROJECT_ID=
GCP_SECRET_MASTER_KEY_NAME=
GCP_SECRET_LOOKUP_SALT_NAME=

# =====================================================================
# C10 — WhatsApp / Meta Cloud API
# =====================================================================
# [runtime] App secret (valida assinatura HMAC dos webhooks). Não é per-clínica.
META_APP_SECRET=""
# [runtime] Token do handshake de verificação do webhook (GET hub.verify_token).
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v21.0"
# META_HTTP_TIMEOUT_MS=10000
# [runtime] Embedded Signup (conexão self-service pelo owner). NÃO são secrets.
META_APP_ID=""
META_CONFIG_ID=""

# =====================================================================
# C11 — AI Agent (Gemini)
# =====================================================================
# [runtime] API key do Google AI Studio.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# AI_HTTP_TIMEOUT_MS=15000
# AI_MONTHLY_COST_LIMIT_USD=50
# AI_SNAPSHOT_MODE=                          # off | full | sample (default: full fora de prod)

# =====================================================================
# C13 — Billing (Asaas)
# =====================================================================
# [runtime] API key do Asaas. Sandbox por padrão (seguro por omissão).
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
# [runtime] Token enviado no header `asaas-access-token` de cada webhook.
ASAAS_WEBHOOK_TOKEN=""
# ASAAS_HTTP_TIMEOUT_MS=10000

# =====================================================================
# E-mail transacional (LGPD)
# =====================================================================
# [runtime] Chave server-only do Resend e remetente de domínio verificado.
RESEND_API_KEY=""
EMAIL_FROM="Qoro <privacidade@seu-dominio.com>"

# =====================================================================
# C14 — Proactive Jobs (nomes dos templates Meta aprovados, por ambiente)
# =====================================================================
META_TEMPLATE_CONFIRMATION_REMINDER_ID=""
META_TEMPLATE_DUNNING_FRIENDLY_ID=""
META_TEMPLATE_FOLLOWUP_RETURN_ID=""
META_TEMPLATE_LANG="pt_BR"

# =====================================================================
# C15 — Platform Admin / Onboarding
# =====================================================================
# [runtime] HMAC do cookie de impersonate. MÍNIMO 32 chars.
IMPERSONATION_SECRET=""
# [runtime] HMAC do token do link mágico /join. MÍNIMO 32 chars.
MAGIC_TOKEN_SECRET=""

# =====================================================================
# C16 — Observabilidade (Sentry)
# =====================================================================
# DSN é publishable (vai pro bundle client). Ausente → usa DSN baked-in do wizard.
NEXT_PUBLIC_SENTRY_DSN=""
# [prod/build] Upload de source maps. Vive em .env.sentry-build-plugin (gitignored).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
