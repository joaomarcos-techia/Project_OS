# =====================================================================
# ClinicaOS — Environment variables template
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored.
#
# Status: C0. Most vars are still empty/optional because the modules
# that consume them don't exist yet. Each var becomes REQUIRED in the
# camada noted in `src/lib/env.ts` next to its definition.
# =====================================================================

# --- Database (C1) ---
DATABASE_URL=
DATABASE_URL_PROD=

# --- Supabase (C1 / C3) ---
# Supabase renamed API keys in 2024. Prefer the new names below.
# Legacy names (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work.
# Get all keys in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy (optional — keep blank if using the new keys above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
