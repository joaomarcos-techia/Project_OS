# =====================================================================
# ClinicaOS — Environment variables template
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored.
#
# Each var carries a camada tag indicating when it became REQUIRED. See
# src/lib/env.ts for the authoritative validation schema (Zod).
# =====================================================================

# --- Database (C1 — required everywhere) ---
# Supabase Transaction Pooler (port 6543) — required for Next.js serverless.
# IMPORTANT: must end with `?sslmode=require`. Scripts (db:migrate:*) refuse
# without it. The pooler enforces SSL anyway, but psql/pg_dump rely on the
# URL string for the same.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Required only in NODE_ENV=production. Leave blank in dev — `qoro-prod` does
# not exist yet. Set in operator's shell session right before prod operations,
# NEVER persist in .env.local on dev workstations.
DATABASE_URL_PROD=

# --- Supabase (C1 — URL + one key required; C3 — secret key required) ---
# Supabase renamed API keys in 2024. Prefer the new names below; legacy aliases
# (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work.
# Get all keys in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Legacy aliases (optional — leave blank if using the new keys above).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Operational opt-in ---
# Hard gate for db:migrate:prod / db:backup:prod. Default unset.
# Set to `prod` ONLY in the shell session right before a prod operation:
#   export SUPABASE_PROJECT_ENV=prod
# Never write `prod` here on a dev workstation.
SUPABASE_PROJECT_ENV=
